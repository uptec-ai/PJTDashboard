rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 문서 파일: 회원은 전체, 게스트는 "게스트 공개" 메타데이터가 있는 파일만
    match /projects/{pid}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.token.firebase.sign_in_provider != 'anonymous'
            || (resource.metadata != null && resource.metadata.public == 'true'));
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
