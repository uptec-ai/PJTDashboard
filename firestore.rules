rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return profile().role;
    }

    function isMaster() {
      return signedIn() && role() == 'master';
    }

    function notDisabled() {
      return signedIn() && !(profile().get('disabled', false) == true);
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // 회원 = 마스터 또는 회원(personal). 전체 탭(장비·DB설계·업데이트 이력 포함) 열람
    function isMember() {
      return signedIn() && !isAnonymous() && role() in ['personal', 'master'];
    }

    // 승인된 사용자 = 비회원 이상. 회사 카테고리의 개요·일정/이슈·문서 열람
    function isApproved() {
      return signedIn() && !isAnonymous() && role() in ['nonmember', 'personal', 'master'];
    }

    // ---------- 회원 ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMaster());
      allow list: if isMaster();

      // 가입 시 본인 문서 생성: 익명은 guest, 일반 가입은 pending(승인 대기)
      allow create: if signedIn() && request.auth.uid == uid
        && ((isAnonymous() && request.resource.data.role == 'guest')
            || (!isAnonymous() && request.resource.data.role == 'pending'))
        && request.resource.data.get('disabled', false) == false;

      // 본인 수정: 역할/비활성화는 변경 불가. 마스터: 전체 수정 (승인·등급 변경)
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))
                    || isMaster();

      allow delete: if (signedIn() && request.auth.uid == uid) || isMaster();

      // ---------- 내 공간 (완전 비공개 — 본인만, 마스터도 열람 불가) ----------
      // 계정 삭제 시 정리는 Cloud Functions(관리자 SDK)가 수행한다.
      match /events/{eid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /notes/{nid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- 아이디 → 이메일 매핑 (아이디+비밀번호 로그인용) ----------
    match /usernames/{uname} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && uname.matches('^[a-z0-9_-]{3,20}$');
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMaster());
    }

    // ---------- ID 찾기: 이메일 → 아이디 ----------
    match /emailLookup/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn();
      allow delete: if signedIn();
      allow update: if false;
    }

    // ---------- 프로젝트 ----------
    // 열람: 마스터=전체 / 회원·비회원=회사 카테고리만 / 게스트=공개 프로젝트
    // 작성·수정: 마스터만 (회원·비회원은 조회 전용, 코멘트 작성은 허용)
    match /projects/{pid} {
      function isCompany() {
        return resource.data.get('category', 'company') == 'company';
      }

      allow read: if notDisabled()
        && (isMaster()
            || (isApproved() && isCompany())
            || (isAnonymous() && resource.data.get('isPublic', false) == true));

      allow create: if notDisabled() && isMaster()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if notDisabled() && isMaster();

      // 하위 컬렉션 — 정확히 한 단계만.
      // 주의: {sub=**}는 규칙 v2에서 빈 경로도 매칭되어 프로젝트 문서 자체가 뚫리므로 사용 금지
      function parent() {
        return get(/databases/$(database)/documents/projects/$(pid)).data;
      }
      function parentIsCompany() {
        return parent().get('category', 'company') == 'company';
      }
      function parentIsPublic() {
        return parent().get('isPublic', false) == true;
      }
      // 비회원 이상이 볼 수 있는 프로젝트인가 (마스터는 전체)
      function canViewParent() {
        return isMaster() || (isApproved() && parentIsCompany());
      }
      // 회원 이상이 볼 수 있는 프로젝트인가
      function memberCanViewParent() {
        return isMaster() || (isMember() && parentIsCompany());
      }

      // 기본(장비·연동로그 등) = 회원 이상
      match /{sub}/{docId} {
        allow read: if notDisabled() && memberCanViewParent();
        allow write: if notDisabled() && isMaster();
      }
      // DB 설계 = 회원 이상
      match /design/{docId} {
        allow read: if notDisabled() && memberCanViewParent();
        allow write: if notDisabled() && isMaster();
      }
      // 업데이트 이력 = 회원 이상 + 게스트(공개 프로젝트)
      match /updates/{docId} {
        allow read: if notDisabled()
          && (memberCanViewParent() || (isAnonymous() && parentIsPublic()));
      }
      // 일정·이슈 = 비회원 이상
      match /tasks/{docId} {
        allow read: if notDisabled() && canViewParent();
      }
      // 문서 = 비회원 이상 (게스트는 공개 문서만)
      match /documents/{docId} {
        allow read: if notDisabled()
          && (canViewParent()
              || (isAnonymous() && parentIsPublic() && resource.data.get('isPublic', false) == true));
      }
      // 개요 구성 요소 (지표·달성률 추이) = 비회원 이상, 지표는 게스트도
      match /metrics/{docId} {
        allow read: if notDisabled() && (canViewParent() || (isAnonymous() && parentIsPublic()));
      }
      match /progressHistory/{docId} {
        allow read: if notDisabled() && canViewParent();
      }
      // 요청·코멘트 = 비회원 이상 + 게스트(공개 프로젝트), 작성 가능
      match /comments/{docId} {
        allow read: if notDisabled() && (canViewParent() || (isAnonymous() && parentIsPublic()));
        allow create: if notDisabled()
          && (canViewParent() || (isAnonymous() && parentIsPublic()))
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.acked == false
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 30;
        allow update: if notDisabled() && isMaster();
        allow delete: if notDisabled()
          && (request.auth.uid == resource.data.authorUid || isMaster());
      }
    }
  }
}
