rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMaster() {
      return signedIn() && profile().role == 'master';
    }

    function notDisabled() {
      return signedIn() && !(profile().get('disabled', false) == true);
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // 회원 = 마스터 또는 승인된 회원(personal). 비회원(pending)·게스트는 제외
    function isMember() {
      return signedIn() && !isAnonymous()
        && profile().role in ['personal', 'master'];
    }

    // ---------- 회원 ----------
    match /users/{uid} {
      // 본인 또는 마스터만 열람. 회원 관리 목록 조회는 마스터만.
      allow get: if signedIn() && (request.auth.uid == uid || isMaster());
      allow list: if isMaster();

      // 가입 시 본인 문서 생성: 익명은 guest, 일반 가입은 pending(비회원 — 마스터 승인 대기)
      allow create: if signedIn() && request.auth.uid == uid
        && ((isAnonymous() && request.resource.data.role == 'guest')
            || (!isAnonymous() && request.resource.data.role == 'pending'))
        && request.resource.data.get('disabled', false) == false;

      // 본인 수정: 역할/비활성화 필드는 변경 불가. 마스터: 전체 수정 가능 (승인 = role pending→personal)
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))
                    || isMaster();

      // 탈퇴: 본인 또는 마스터
      allow delete: if (signedIn() && request.auth.uid == uid) || isMaster();

      // ---------- 내 공간 (완전 비공개 — 본인만, 마스터도 열람·삭제 불가) ----------
      // 마스터가 계정을 삭제해도 이 데이터는 읽히지 않는다 (프로필이 없어져 접근 경로 자체가 사라짐)
      match /events/{eid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /notes/{nid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- 아이디 → 이메일 매핑 (아이디+비밀번호 로그인용) ----------
    match /usernames/{uname} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && uname.matches('^[a-z0-9_-]{3,20}$');
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMaster());
    }

    // ---------- ID 찾기: 이메일 → 아이디 ----------
    match /emailLookup/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn();
      allow delete: if signedIn();
      allow update: if false;
    }

    // ---------- 프로젝트 ----------
    // 권한: 마스터/회원 = 전체 열람·본인 것 작성, 비회원(pending) = 접근 불가,
    //       게스트(익명) = 공개 프로젝트의 공개 정보만
    match /projects/{pid} {
      allow read: if notDisabled()
        && (isMember() || (isAnonymous() && resource.data.get('isPublic', false) == true));

      allow create: if notDisabled() && isMember()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if notDisabled()
        && ((isMember() && resource.data.ownerUid == request.auth.uid) || isMaster());

      // 하위 컬렉션 — 정확히 한 단계만.
      // 주의: {sub=**}는 규칙 v2에서 빈 경로도 매칭되어 프로젝트 문서 자체가 뚫리므로 사용 금지
      function projectIsPublic() {
        return get(/databases/$(database)/documents/projects/$(pid)).data.get('isPublic', false) == true;
      }
      function isProjectOwner() {
        return get(/databases/$(database)/documents/projects/$(pid)).data.ownerUid == request.auth.uid;
      }

      match /{sub}/{docId} {
        allow read: if notDisabled() && isMember();
        allow write: if notDisabled() && isMember() && (isProjectOwner() || isMaster());
      }
      match /metrics/{docId} {
        allow read: if notDisabled() && (isMember() || (isAnonymous() && projectIsPublic()));
      }
      match /updates/{docId} {
        allow read: if notDisabled() && (isMember() || (isAnonymous() && projectIsPublic()));
      }
      match /documents/{docId} {
        // 게스트는 공개 프로젝트의 isPublic 문서만
        allow read: if notDisabled()
          && (isMember()
              || (isAnonymous() && projectIsPublic() && resource.data.get('isPublic', false) == true));
      }
      match /comments/{docId} {
        allow read: if notDisabled() && (isMember() || (isAnonymous() && projectIsPublic()));
        // 회원 + 게스트(공개 프로젝트만) 작성 가능 — 본인 uid·미확인 상태·길이 제한 강제
        allow create: if notDisabled()
          && (isMember() || (isAnonymous() && projectIsPublic()))
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.acked == false
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 30;
        // 확인함 처리: 마스터/소유자만
        allow update: if notDisabled() && isMember() && (isProjectOwner() || isMaster());
        // 삭제: 작성자 본인 또는 마스터/소유자
        allow delete: if notDisabled()
          && (request.auth.uid == resource.data.authorUid
              || (isMember() && (isProjectOwner() || isMaster())));
      }
    }
  }
}
